 "motion": {
  "fps": {
   "target": 20,
   "locks": [20, 10, 8, 7, 6, 5],
   "lock_note": "The frame lock is the fastest of these at or under the params cap whose period the loop's measured cost fits (app/pacer.py). 10 and 20 divide every zone period, so ring spawns and heartbeats land on a frame; 8 keeps WARM and HOT on one; 7..5 only when the watch cannot hold 8.",
   "budget_note": "Stock v1.29 SPI on GPIO-matrix pins caps at 26.67 MHz: 34.6 ms/frame push, so 20 fps is the target; a NO_DUMMY build at 40 MHz gives 23 ms/frame."
  },
  "duration_ms": {
   "instant": 0,
   "fast": 150,
   "base": 250,
   "slow": 600,
   "hue_crossfade": 1500,
   "toast_dwell": 2500,
   "breathe_found": 2400,
   "breathe_pairing": 2400
  },
  "easing": {
   "linear": "t",
   "out_cubic": "1-(1-t)^3",
   "in_cubic": "t^3",
   "in_out_cubic": "t<0.5 ? 4t^3 : 1-(-2t+2)^3/2",
   "in_out_sine": "-(cos(pi*t)-1)/2",
   "smoothstep": "t*t*(3-2t)"
  },
  "use": {
   "ripple_travel": "linear",
   "pulse_profile_edges": "smoothstep",
   "zone_param_crossfade": {
    "ms": 600,
    "ease": "in_out_cubic"
   },
   "hue_ramp_crossfade": {
    "ms": 1500,
    "ease": "in_out_cubic",
    "found_ms": 400
   },
   "iris_open_close": {
    "ms": 300,
    "ease": "out_cubic"
   },
   "arrow_appear": {
    "ms": 250,
    "ease": "out_cubic",
    "scale_from": 0.6
   },
   "arrow_angle": {
    "type": "exponential",
    "tau_ms": 200,
    "deadband_deg": 4,
    "path": "shortest"
   },
   "scan_result_morph": {
    "ms": 400,
    "ease": "out_cubic"
   },
   "chevron_nudge": {
    "ms": 800,
    "ease": "in_out_sine",
    "offset_px": 6,
    "loop": true
   },
   "toast_in": {
    "ms": 200,
    "ease": "out_cubic",
    "offset_px": 12
   },
   "toast_out": {
    "ms": 150,
    "ease": "in_cubic"
   },
   "breathing": {
    "ease": "in_out_sine"
   },
   "sweep_rotation": {
    "ease": "linear",
    "deg_per_s": 30
   }
  },
  "flash_limit": "No full-field luminance change of more than 2 ramp steps in under 333 ms (stay below 3 flashes/s).",
  "temporal_aa": "lead_eff_px = max(lead_px, 1.5*|speed_px_s|/fps_measured); ring profiles evaluated at fractional r_k"
 },
 "field": {
  "ring_map": "GS8 index map (240x240, 57.6 KB; the watch blits from its top-right quadrant, 120x120, mirrored x -> 239-x and y -> 239-y): idx = floor(hypot(x-119.5, y-119.5)), values 0..168",
  "palette": "256x1 RGB565 FrameBuffer, entries 0..169 rebuilt every frame (the map uses 0..168); each 240x60 band of the frame blits its ring-map rows through it with key -1",
  "value_formula": "v(i,t) = clamp(0, 7, vignette(i) * (floor + glow_amp*exp(-(i/glow_r)^2) + pulse_amp*sum_k fadein(r_k)*profile(i - r_k(t))))",
  "color_formula": "color(i) = LUT[ramp][round(v/7*63)]",
  "ring_radius": "r_k(t) = spawn_r + speed_px_s * (t - t_k); ring k spawns every period_ms; spawn_r = iris radius (0 when no iris)",
  "profile": "d = i - r_k; d >= 0: 1 - smoothstep(0, lead_px, d); d < 0: 1 - smoothstep(0, trail_px, -d)",
  "fadein_px": 12,
  "vignette_stops": [
   [
    0,
    1.0
   ],
   [
    88,
    1.0
   ],
   [
    120,
    0.4
   ],
   [
    168,
    0.15
   ]
  ],
  "iris": "indices < iris_r paint bg.iris; indices iris_r..iris_r+2 are the rim at level min(7, max(5, floor+glow_amp)); when an iris is open the center glow becomes a halo: glow term uses (i - iris_r) instead of i",
  "param_change_rule": "period/speed changes apply to rings spawned after the change; floor/glow/amp crossfade over motion.use.zone_param_crossfade",
  "intensity_map": {
   "floor": "0.3 + 1.3*I",
   "glow_amp": "2.0 + 4.0*I",
   "pulse_amp": "4.0 + 1.5*I",
   "glow_r_px": "20 + 40*I (FOUND 90)"
  },
  "inward_rings": "speed_px_s < 0: rings spawn at r=168 and are absorbed at the iris edge (listening / no data); always in the field's ramp, never ghosts",
  "ghost_rings": "outward ring (speed_px_s > 0) spawned with ring_live=False adds 0.6*pulse_amp to a grey channel; colour = LUT.grey where v_ghost > v_green; no haptic",
  "core_dot": "iris_r == 0: indices 0..6 get v >= 6 (prox.6)",
  "standing_wave": "FOUND: v = 2.0 + 2.5*(0.5+0.5cos(2*pi*i/32))*(0.6+0.4 sin(2*pi*t/2400)), glow_r 90"
 },
