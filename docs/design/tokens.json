 "meta": {
  "display": {
   "width_px": 240,
   "height_px": 240,
   "diagonal_in": 1.54,
   "ppi_approx": 220,
   "panel": "ST7789 IPS",
   "color_format": "RGB565"
  },
  "color_encoding": "Every hex is exact in RGB565: 8-bit channel = bit-replicated 5/6-bit value (r8 = r5<<3 | r5>>2, g8 = g6<<2 | g6>>4). The listed rgb565 is the plain (big-endian) RGB565 of each hex; hal.st7789.rgb565(r,g,b) returns the byte-swapped value (rgb565_swapped).",
  "rgb565_swapped_note": "MicroPython framebuf RGB565 stores pixels little-endian; the ST7789 expects big-endian bytes on SPI. Put rgb565_swapped values into the palette FrameBuffer (finder.tuning carries them; hal.st7789.rgb565()/swap16() build them) so ST7789.push_strip()/push_frame() send correct bytes.",
  "angles": "Degrees clockwise from 12 o'clock (screen-up = 0).",
  "coordinates": "Pixels on the 240x240 physical display, origin top-left, y down. Overlay glyph geometry is relative to the overlay center (120,120) and drawn pointing UP (screen-up = the direction the player faced when the last scan ended).",
  "calibration": "Values marked calibrate:true are starting points to be tuned with real devices, not measured facts.",
  "changelog_0_2_0": "Applied ui-spec.md section 10 (typography.word, top_slot, core_dot, fps 20/15, sweep 30 deg/s, temporal AA, intensity map, inward/ghost rings, zones 28/36 14/18 7/9 with dwell, bands, calibration at 1 m, trend gating, arrow sigma model, scan params, link timers, bump-only FOUND, beacon rates, 9-pattern haptics)."
 },
