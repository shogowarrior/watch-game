.pio/
# generated by PlatformIO from sdkconfig.defaults
idf/sdkconfig.*
!idf/sdkconfig.defaults
# Wi-Fi name and password, if a native build ever needs them: only in a file
# named wifi_secrets.h (C/C++) or secrets.ini (PlatformIO extra_configs), at
# any depth. Never in platformio.ini, build flags, sdkconfig*, source or logs.
wifi_secrets.h
secrets.ini
